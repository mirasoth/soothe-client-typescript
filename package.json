{
  "name": "@mirasoth/soothe-client",
  "version": "0.5.2",
  "description": "WebSocket client in TypeScript for soothe-daemon",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "SOOTHE_INTEGRATION=1 vitest run test/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" && npm run format"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirasoth/soothe-client-typescript.git"
  },
  "keywords": [
    "soothe",
    "websocket",
    "client",
    "daemon",
    "typescript"
  ],
  "author": "OpenSoothe",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=19.0.0"
  },
  "dependencies": {
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.0.0"
  }
}
